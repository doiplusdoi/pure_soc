# PureSOC Microsoft 365 read-only tenant smoke environment shape.
#
# This file is safe to commit because every value is a placeholder.
# Put real values only in a private, ignored local environment file or an
# operator-owned secret store. Do not commit real tenant IDs, client IDs,
# client secrets, provider-token keys, smoke output, or raw Graph payloads.

# Dry-run defaults. These let operators inspect readiness without calling
# Microsoft identity or Microsoft Graph.
PURESOC_EXTERNAL_SMOKE_MODE=dry_run
PURESOC_EXTERNAL_SMOKE_TARGET_KIND=
PURESOC_EXTERNAL_SMOKE_CONFIRM_DISPOSABLE=false
PURESOC_EXTERNAL_SMOKE_MICROSOFT365=false

# Live-candidate guardrails. Copy these values into a private local env file
# only after a disposable/test tenant is approved and the selector is expected
# to choose exactly one path.
# PURESOC_EXTERNAL_SMOKE_MODE=live_candidate
# PURESOC_EXTERNAL_SMOKE_TARGET_KIND=disposable
# PURESOC_EXTERNAL_SMOKE_CONFIRM_DISPOSABLE=true
# PURESOC_EXTERNAL_SMOKE_MICROSOFT365=true

# Microsoft 365 disposable/test app registration.
MICROSOFT365_CLIENT_ID=<test-app-client-id>
MICROSOFT365_CLIENT_SECRET=<test-app-client-secret>
PURESOC_MICROSOFT365_SMOKE_TENANT_ID=<test-tenant-id>

# Provider-token envelope key for this disposable run.
# Use strong per-run or per-environment material. This local key-ring mode is
# suitable for disposable/local smoke only; SaaS custody still needs a real
# KMS/HSM/secret-manager adapter before production tenant onboarding.
PURESOC_PROVIDER_TOKEN_KEY_PROVIDER=local-env-key-ring
PURESOC_PROVIDER_TOKEN_CUSTODY_TARGET_KIND=local
PURESOC_PROVIDER_TOKEN_KEY_ID=m365-smoke-local
PURESOC_PROVIDER_TOKEN_KEY=<strong-local-disposable-key-material>
PURESOC_PROVIDER_TOKEN_PREVIOUS_KEYS=

# Provider writes must stay disabled for V1 real-tenant validation.
PURESOC_CONNECTOR_RUNNER_ALLOW_PROVIDER_WRITES=false

# Optional aliases accepted by the smoke runner:
# M365_CLIENT_ID=<test-app-client-id>
# M365_CLIENT_SECRET=<test-app-client-secret>
# MICROSOFT365_TENANT_ID=<test-tenant-id>
# M365_TENANT_ID=<test-tenant-id>
