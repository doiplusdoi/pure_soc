# PureSOC first-run Compose defaults.
#
# No .env file is required for `docker compose up`.
# The default Compose catalog wires its own internal Postgres URL, local MinIO
# bucket credentials, report renderer, and upload scanner. Optional integrations
# are disabled in code defaults and should not be copied in as blank secrets.
#
# Uncomment only the values you intentionally override.

# Public deployment hardening.
# PURESOC_APP_ENV=production
# PURESOC_PUBLIC_BASE_URL=https://puresoc.example.com
# PURESOC_API_BASE_URL=http://puresoc-api:3001
# Optional override if the proxy does not send forwarded host/proto headers to puresoc-web.
# PURESOC_WEB_PUBLIC_BASE_URL=https://puresoc.example.com
# Extra browser origins allowed to call the API directly. Leave unset when only puresoc-web is public.
# PURESOC_API_TRUSTED_ORIGINS=https://api.puresoc.example.com
# PURESOC_AUTH_COOKIE_SECURE=true
# PURESOC_AUTH_REQUIRE_EMAIL_VERIFICATION=true
# PURESOC_API_REQUIRE_ORIGIN_OR_REFERER=true

# Managed Postgres override. Leave unset for the bundled Compose database.
# DATABASE_URL=postgresql://user:password@host:5432/puresoc

# Microsoft 365 live connector app. Leave unset for fixture-mode demos.
# PURESOC_CONNECTOR_MICROSOFT365_MODE=live
# PURESOC_CONNECTOR_MICROSOFT365_CLIENT_ID=
# PURESOC_CONNECTOR_MICROSOFT365_CLIENT_SECRET=
# PURESOC_CONNECTOR_MICROSOFT365_REDIRECT_URI=https://puresoc.example.com/providers/microsoft365/callback
# PURESOC_PROVIDER_TOKEN_KEY_ID=current
# PURESOC_PROVIDER_TOKEN_KEY=

# User social-login providers. Local email/password is enabled by default.
# PURESOC_AUTH_MICROSOFT_ENTRA_ENABLED=true
# PURESOC_AUTH_MICROSOFT_ENTRA_CLIENT_ID=
# PURESOC_AUTH_MICROSOFT_ENTRA_CLIENT_SECRET=
# PURESOC_AUTH_MICROSOFT_ENTRA_REDIRECT_URI=https://puresoc.example.com/auth/oidc/microsoft_entra/callback
# PURESOC_AUTH_GOOGLE_ENABLED=true
# PURESOC_AUTH_GOOGLE_CLIENT_ID=
# PURESOC_AUTH_GOOGLE_CLIENT_SECRET=
# PURESOC_AUTH_GOOGLE_REDIRECT_URI=https://puresoc.example.com/auth/oidc/google/callback
# PURESOC_AUTH_GITHUB_ENABLED=true
# PURESOC_AUTH_GITHUB_CLIENT_ID=
# PURESOC_AUTH_GITHUB_CLIENT_SECRET=
# PURESOC_AUTH_GITHUB_REDIRECT_URI=https://puresoc.example.com/auth/oidc/github/callback
# PURESOC_AUTH_OIDC_TRANSIENT_STATE_KEY=

# Billing and notification delivery are opt-in.
# PURESOC_BILLING_PROVIDER=stripe
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_BASE=
# STRIPE_PRICE_ID_PRO=
# STRIPE_PRICE_ID_MSP=
# PURESOC_NOTIFICATIONS_SMTP_ENABLED=true
# PURESOC_NOTIFICATIONS_SMTP_HOST=
# PURESOC_NOTIFICATIONS_SMTP_USERNAME=
# PURESOC_NOTIFICATIONS_SMTP_PASSWORD=
# PURESOC_NOTIFICATIONS_SMTP_FROM=notifications@example.com
