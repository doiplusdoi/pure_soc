# PureSOC first-run installer defaults.
# Optional Microsoft 365, social-login, Stripe, and S3 secrets are intentionally
# omitted here. Add those variables only when enabling that integration.

PURESOC_APP_ENV=development
PURESOC_PERSISTENCE_MODE=memory

PURESOC_PUBLIC_BASE_URL=http://localhost:3000
PURESOC_API_BASE_URL=http://localhost:3001
PURESOC_WEB_PUBLIC_BASE_URL=http://localhost:3000
PURESOC_WEB_API_BASE_URL=http://localhost:3001
PURESOC_API_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PURESOC_API_ORIGIN_PROTECTION_ENABLED=true
PURESOC_API_REQUIRE_ORIGIN_OR_REFERER=false

DATABASE_URL=postgresql://puresoc:puresoc@puresoc-postgres:5432/puresoc

PURESOC_AUTH_LOCAL_ENABLED=true
PURESOC_AUTH_BROKER_ENABLED=false
PURESOC_AUTH_COOKIE_SECURE=false

# Keep optional integrations off for the minimal local/Romania readiness path.
PURESOC_MICROSOFT365_PROVIDER_ENABLED=false
PURESOC_CONNECTOR_RUNNER_ALLOW_PROVIDER_WRITES=false
PURESOC_BILLING_PROVIDER=none
PURESOC_OBJECT_STORAGE_PROVIDER=memory
PURESOC_UPLOAD_SCANNER_MODE=noop
REGULATORY_SOURCE_MONITOR_ENABLED=false

PURESOC_REPORT_STORE_GENERATED_AS_EVIDENCE=true
PURESOC_JOB_QUEUE_PROVIDER=memory
PURESOC_API_RATE_LIMIT_STORE_PROVIDER=memory

# External smoke readiness is metadata-only unless an operator selects exactly
# one approved local/test/ci/disposable target and enables its opt-in flag.
PURESOC_EXTERNAL_SMOKE_MODE=dry_run
PURESOC_EXTERNAL_SMOKE_TARGET_KIND=
PURESOC_EXTERNAL_SMOKE_CONFIRM_DISPOSABLE=false
