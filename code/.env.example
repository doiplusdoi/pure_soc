PURESOC_SCHEDULER_INTERVAL_MS=3600000
PURESOC_CONNECTOR_RUNNER_ENABLED=true
PURESOC_CONNECTOR_RUNNER_ALLOW_PROVIDER_WRITES=false

# External integration smoke readiness is metadata-only by default.
# The readiness command does not call live services:
#   pnpm external-smoke:readiness
