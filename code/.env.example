PURESOC_AUDIT_CHECKPOINT_CADENCE_DAYS=30
PURESOC_AUDIT_EXTERNAL_CHECKPOINT_PROVIDER=none
PURESOC_AUTH_LOCAL_ENABLED=true
PURESOC_AUTH_BROKER_ENABLED=false
PURESOC_AUTH_COOKIE_SECURE=false
PURESOC_AUTH_OIDC_TRANSIENT_STATE_KEY=local-dev-oidc-transient-state-key-change-me
PURESOC_BILLING_PROVIDER=none
PURESOC_JOB_QUEUE_PROVIDER=memory
PURESOC_JOB_DEFAULT_MAX_ATTEMPTS=3
