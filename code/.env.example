PURESOC_APP_ENV=development
PURESOC_PERSISTENCE_MODE=memory
PURESOC_PUBLIC_BASE_URL=http://localhost:3000
PURESOC_API_BASE_URL=http://localhost:3001
PURESOC_API_MAX_JSON_BODY_BYTES=15728640
PURESOC_STRIPE_WEBHOOK_MAX_RAW_BODY_BYTES=1048576
PURESOC_EVIDENCE_MAX_UPLOAD_BYTES=10485760
DATABASE_URL=postgresql://puresoc:puresoc@puresoc-postgres:5432/puresoc
PURESOC_DATABASE_URL=postgresql://puresoc:puresoc@puresoc-postgres:5432/puresoc
PURESOC_REDIS_URL=redis://puresoc-redis:6379/0
PURESOC_PROVIDER_TOKEN_KEY=local-dev-provider-token-key-change-me
PURESOC_OBJECT_STORAGE_PROVIDER=memory
PURESOC_OBJECT_STORAGE_ENDPOINT=http://puresoc-object-storage:9000
PURESOC_OBJECT_STORAGE_REGION=us-east-1
PURESOC_OBJECT_STORAGE_BUCKET=puresoc-local
PURESOC_OBJECT_STORAGE_ACCESS_KEY_ID=puresoc
PURESOC_OBJECT_STORAGE_SECRET_ACCESS_KEY=puresoc-local-minio
PURESOC_OBJECT_STORAGE_FORCE_PATH_STYLE=true
PURESOC_UPLOAD_SCANNER_MODE=noop
PURESOC_UPLOAD_SCANNER_ALLOW_NOOP_IN_PRODUCTION=false
PURESOC_UPLOAD_SCANNER_TIMEOUT_MS=10000
REGULATORY_SOURCE_MONITOR_ENABLED=false
REGULATORY_SOURCE_MONITOR_TIMEOUT_MS=5000
REGULATORY_SOURCE_MONITOR_STALE_AFTER_DAYS=90
REGULATORY_SOURCE_MONITOR_REVIEW_ORGANIZATION_ID=
PURESOC_REPORT_STORE_GENERATED_AS_EVIDENCE=true
PURESOC_AUTH_LOCAL_ENABLED=true
PURESOC_AUTH_BROKER_ENABLED=false
PURESOC_AUTH_COOKIE_SECURE=false
PURESOC_BILLING_PROVIDER=none
