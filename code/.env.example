# PureSOC first-run installer defaults.
# Optional Microsoft 365, social-login, Stripe, and S3 secrets are intentionally
# blank here. Add real values before using the matching live integration.

PURESOC_APP_ENV=development
PURESOC_PERSISTENCE_MODE=prisma

PURESOC_PUBLIC_BASE_URL=http://localhost:3000
PURESOC_API_BASE_URL=http://localhost:3001
PURESOC_WEB_PUBLIC_BASE_URL=http://localhost:3000
PURESOC_WEB_API_BASE_URL=http://localhost:3001
PURESOC_API_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PURESOC_API_ORIGIN_PROTECTION_ENABLED=true
PURESOC_API_REQUIRE_ORIGIN_OR_REFERER=false

# Compose services use the internal puresoc-postgres hostname. Host-run demo
# commands should override this with localhost, for example:
# DATABASE_URL=postgresql://puresoc:puresoc@localhost:5432/puresoc npm run demo:seed
DATABASE_URL=postgresql://puresoc:puresoc@puresoc-postgres:5432/puresoc

PURESOC_AUTH_LOCAL_ENABLED=true
PURESOC_AUTH_REQUIRE_EMAIL_VERIFICATION=false
PURESOC_AUTH_BROKER_ENABLED=false
PURESOC_AUTH_COOKIE_SECURE=false

# Optional integrations still need their own credentials before live use.
PURESOC_CONNECTOR_RUNNER_ALLOW_PROVIDER_WRITES=false
PURESOC_CONNECTOR_MICROSOFT365_WRITE_SCOPES_ALLOWED=false
PURESOC_BILLING_PROVIDER=none
PURESOC_OBJECT_STORAGE_PROVIDER=memory
PURESOC_UPLOAD_SCANNER_MODE=noop
REGULATORY_SOURCE_MONITOR_ENABLED=false

PURESOC_REPORT_STORE_GENERATED_AS_EVIDENCE=true
PURESOC_REPORT_RENDERER=http://puresoc-report-renderer:3002
PURESOC_NOTIFICATIONS_SMTP_ENABLED=false
PURESOC_NOTIFICATIONS_SMTP_HOST=
PURESOC_NOTIFICATIONS_SMTP_PORT=587
PURESOC_NOTIFICATIONS_SMTP_SECURE=false
PURESOC_NOTIFICATIONS_SMTP_STARTTLS=true
PURESOC_NOTIFICATIONS_SMTP_USERNAME=
PURESOC_NOTIFICATIONS_SMTP_PASSWORD=
PURESOC_NOTIFICATIONS_SMTP_FROM=notifications@puresoc.local
PURESOC_NOTIFICATIONS_WEBHOOK_TIMEOUT_MS=5000
PURESOC_NOTIFICATIONS_DEADLINE_SCAN_INTERVAL_MS=1800000
PURESOC_JOB_QUEUE_PROVIDER=memory
PURESOC_API_RATE_LIMIT_STORE_PROVIDER=memory

# External smoke readiness is metadata-only unless an operator selects exactly
# one approved local/test/ci/disposable target and enables its opt-in flag.
PURESOC_EXTERNAL_SMOKE_MODE=dry_run
PURESOC_EXTERNAL_SMOKE_TARGET_KIND=
PURESOC_EXTERNAL_SMOKE_CONFIRM_DISPOSABLE=false
PURESOC_EXTERNAL_SMOKE_MICROSOFT365=false
PURESOC_EXTERNAL_SMOKE_STRIPE=false
PURESOC_EXTERNAL_SMOKE_OIDC_MICROSOFT_ENTRA=false
PURESOC_EXTERNAL_SMOKE_OIDC_GOOGLE=false
PURESOC_EXTERNAL_SMOKE_OIDC_GITHUB=false
PURESOC_EXTERNAL_SMOKE_STORAGE=false
PURESOC_EXTERNAL_SMOKE_EVIDENCE_REPORTS=false
PURESOC_EXTERNAL_SMOKE_AUTH_DEPLOYMENT=false
# Microsoft 365 managed-provider connector app. This is separate from
# Microsoft Entra user sign-in below.
# Register one PureSOC-controlled multitenant Entra app per deployment
# environment and set its client ID, client secret, and exact public callback.
PURESOC_CONNECTOR_MICROSOFT365_MODE=fixture
PURESOC_CONNECTOR_MICROSOFT365_CLIENT_ID=
PURESOC_CONNECTOR_MICROSOFT365_CLIENT_SECRET=
PURESOC_CONNECTOR_MICROSOFT365_AUTHORITY_HOST=https://login.microsoftonline.com
# Must exactly match the Entra app Web redirect URI.
# Public deployments should use:
# https://<puresoc-domain>/providers/microsoft365/callback
PURESOC_CONNECTOR_MICROSOFT365_REDIRECT_URI=
PURESOC_CONNECTOR_MICROSOFT365_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
PURESOC_CONNECTOR_MICROSOFT365_FIXTURE_SET=partner_demo
PURESOC_CONNECTOR_MICROSOFT365_REQUEST_TIMEOUT_MS=10000
PURESOC_CONNECTOR_MICROSOFT365_MAX_RETRIES=3
# Required when Microsoft 365 connector credentials are configured in production.
# Use strong deployment-secret material; do not commit real keys.
PURESOC_PROVIDER_TOKEN_KEY_PROVIDER=local-env-key-ring
PURESOC_PROVIDER_TOKEN_CUSTODY_TARGET_KIND=
PURESOC_PROVIDER_TOKEN_KEY_ID=
PURESOC_PROVIDER_TOKEN_KEY=
PURESOC_PROVIDER_TOKEN_PREVIOUS_KEYS=
PURESOC_PROVIDER_TOKEN_PREVIOUS_KEY_WINDOW_CONFIRMED=false
PURESOC_PROVIDER_TOKEN_BACKFILL_PLAN_CONFIRMED=false
PURESOC_PROVIDER_TOKEN_KEY_RETIREMENT_PLAN_CONFIRMED=false
# Optional disposable smoke only; customer tenant IDs are stored per ProviderConnection.
PURESOC_MICROSOFT365_SMOKE_TENANT_ID=

# PureSOC user sign-in providers. Microsoft Entra sign-in is enabled by
# default; fill the real app registration values before using it.
PURESOC_AUTH_OIDC_TRANSIENT_STATE_KEY=
PURESOC_AUTH_MICROSOFT_ENTRA_ENABLED=true
PURESOC_AUTH_MICROSOFT_ENTRA_CLIENT_ID=
PURESOC_AUTH_MICROSOFT_ENTRA_CLIENT_SECRET=
PURESOC_AUTH_MICROSOFT_ENTRA_REDIRECT_URI=http://localhost:3000/auth/oidc/microsoft_entra/callback
PURESOC_AUTH_GOOGLE_ENABLED=false
PURESOC_AUTH_GOOGLE_CLIENT_ID=
PURESOC_AUTH_GOOGLE_CLIENT_SECRET=
PURESOC_AUTH_GOOGLE_REDIRECT_URI=http://localhost:3001/auth/oidc/google/callback
PURESOC_AUTH_GITHUB_ENABLED=false
PURESOC_AUTH_GITHUB_CLIENT_ID=
PURESOC_AUTH_GITHUB_CLIENT_SECRET=
PURESOC_AUTH_GITHUB_REDIRECT_URI=http://localhost:3001/auth/oidc/github/callback
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_BASE=
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_MSP=
