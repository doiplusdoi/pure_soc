PURESOC_APP_ENV=development
PURESOC_PERSISTENCE_MODE=memory
PURESOC_PUBLIC_BASE_URL=http://localhost:3000
PURESOC_API_BASE_URL=http://localhost:3001
PURESOC_API_MAX_JSON_BODY_BYTES=15728640
PURESOC_STRIPE_WEBHOOK_MAX_RAW_BODY_BYTES=1048576
PURESOC_EVIDENCE_MAX_UPLOAD_BYTES=10485760
PURESOC_API_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
PURESOC_API_ORIGIN_PROTECTION_ENABLED=true
PURESOC_API_REQUIRE_ORIGIN_OR_REFERER=false
PURESOC_API_ORIGIN_EXEMPT_ROUTE_FAMILIES=webhook,oidc_callback,provider_callback
PURESOC_API_RATE_LIMIT_ENABLED=true
PURESOC_API_RATE_LIMIT_WINDOW_MS=60000
PURESOC_API_RATE_LIMIT_MAX_REQUESTS=120
PURESOC_API_RATE_LIMIT_AUTH_MAX_REQUESTS=60
PURESOC_API_RATE_LIMIT_EVIDENCE_MAX_REQUESTS=120
PURESOC_API_RATE_LIMIT_BILLING_MAX_REQUESTS=120
PURESOC_API_RATE_LIMIT_ACTIONS_MAX_REQUESTS=120
PURESOC_API_RATE_LIMIT_REGULATORY_MAX_REQUESTS=120
