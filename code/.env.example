# PureSOC Compose overrides.
#
# A clean checkout runs locally without these values. Set the production
# overrides when placing Compose behind HTTPS and real email delivery.

PURESOC_APP_ENV=development
PURESOC_AUTH_COOKIE_SECURE=false
PURESOC_AUTH_REQUIRE_EMAIL_VERIFICATION=false
PURESOC_WEB_DEFAULT_LOCALE=ro-RO

# PureSOC-controlled multitenant Entra app for customer Microsoft 365 admin consent.
PURESOC_CONNECTOR_MICROSOFT365_MODE=auto
PURESOC_CONNECTOR_MICROSOFT365_CLIENT_ID=
PURESOC_CONNECTOR_MICROSOFT365_CLIENT_SECRET=

# Encrypts stored Microsoft OAuth tokens in the database.
# Generate with: openssl rand -hex 32
# Set both values together for live Microsoft 365; use a stable, non-secret ID such as live-current.
PURESOC_PROVIDER_TOKEN_KEY_ID=live-current
PURESOC_PROVIDER_TOKEN_KEY=
