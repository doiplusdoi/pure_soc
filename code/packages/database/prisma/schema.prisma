model ChecklistTemplate {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  templateKey    String  @map("template_key")
  title          String
  jurisdiction   String?
  sourceControlId String? @map("source_control_id")

  @@map("checklist_templates")
}

model ChecklistTemplateItem {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String? @map("organization_id") @db.Uuid
  templateId     String  @map("template_id") @db.Uuid
  itemKey        String  @map("item_key")
  title          String
  description    String?
  sortOrder      Int     @default(0) @map("sort_order")

  @@map("checklist_template_items")
}

model ChecklistRun {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  templateId     String   @map("template_id") @db.Uuid
  assessmentId   String?  @map("assessment_id") @db.Uuid
  status         String   @default("open")
  createdAt      DateTime @default(now()) @map("created_at")
  completedAt    DateTime? @map("completed_at")

  @@map("checklist_runs")
}

model ChecklistRunItem {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  checklistRunId String   @map("checklist_run_id") @db.Uuid
  templateItemId String?  @map("template_item_id") @db.Uuid
  status         String   @default("open")
  evidenceArtifactId String? @map("evidence_artifact_id") @db.Uuid
  completedBy    String?  @map("completed_by") @db.Uuid
  completedAt    DateTime? @map("completed_at")

  @@map("checklist_run_items")
}

model EvidenceArtifact {
  id                   String             @id @default(uuid()) @db.Uuid
  organizationId       String             @map("organization_id") @db.Uuid
  controlId            String?            @map("control_id")
  jurisdiction         String?
  sourceType           EvidenceSourceType @map("source_type")
  sourceProvider       String?            @map("source_provider")
  providerConnectionId String?            @map("provider_connection_id") @db.Uuid
  manualSourceLabel    String?            @map("manual_source_label")
  title                String
  description          String?
  storageUri           String             @map("storage_uri")
  contentHashSha256    String             @map("content_hash_sha256")
  mimeType             String             @map("mime_type")
  sizeBytes            BigInt?            @map("size_bytes")
  scanStatus           EvidenceScanStatus @default(pending) @map("scan_status")
  scanScannerName      String?            @map("scan_scanner_name")
  scanFindingsJson     Json               @default("[]") @map("scan_findings_json")
  scannedAt            DateTime?          @map("scanned_at")
  createdBy            String?            @map("created_by") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at")
  validFrom            DateTime?          @map("valid_from")
  validUntil           DateTime?          @map("valid_until")
  linkedAssessmentId   String?            @map("linked_assessment_id") @db.Uuid
  linkedActionId       String?            @map("linked_action_id") @db.Uuid
  linkedSourceRecordId String?            @map("linked_source_record_id") @db.Uuid
  exportGroupKey       String?            @map("export_group_key")
  retentionPolicy      String?            @map("retention_policy")
  retentionExpiresAt   DateTime?          @map("retention_expires_at")

  @@map("evidence_artifacts")
}

model EvidenceLink {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  evidenceArtifactId String   @map("evidence_artifact_id") @db.Uuid
  targetType         String   @map("target_type")
  targetId           String   @map("target_id")
  relation           String
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("evidence_links")
}

model EvidenceAccessLog {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  evidenceArtifactId String   @map("evidence_artifact_id") @db.Uuid
  actorUserId        String?  @map("actor_user_id") @db.Uuid
  action             String
  ipAddress          String?  @map("ip_address")
  userAgent          String?  @map("user_agent")
  createdAt          DateTime @default(now()) @map("created_at")

  @@map("evidence_access_logs")
}

model GeneratedReport {
  id                String                @id @default(uuid()) @db.Uuid
  organizationId    String                @map("organization_id") @db.Uuid
  assessmentId      String?               @map("assessment_id") @db.Uuid
  reportType        String                @map("report_type")
  jurisdiction      String?
  status            GeneratedReportStatus @default(draft)
  legalCaveat       String                @map("legal_caveat")
  sourceReferencesJson Json               @default("[]") @map("source_references_json")
  reportDataJson    Json                  @map("report_data_json")
  evidenceArtifactId String?              @map("evidence_artifact_id") @db.Uuid
  createdBy         String?               @map("created_by") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")

  @@map("generated_reports")
}

model ReportExport {
  id               String       @id @default(uuid()) @db.Uuid
  organizationId   String       @map("organization_id") @db.Uuid
  generatedReportId String      @map("generated_report_id") @db.Uuid
  exportFormat     String       @map("export_format")
  status           ExportStatus @default(queued)
  storageUri       String?      @map("storage_uri")
  contentHashSha256 String?     @map("content_hash_sha256")
  createdAt        DateTime     @default(now()) @map("created_at")
  expiresAt        DateTime?    @map("expires_at")

  @@map("report_exports")
}

model DashboardSnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  assessmentId   String?  @map("assessment_id") @db.Uuid
  snapshotType   String   @map("snapshot_type")
  source         String   @default("stored_analysis")
  snapshotJson   Json     @map("snapshot_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("dashboard_snapshots")
}

model DashboardWidget {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  dashboardSnapshotId String   @map("dashboard_snapshot_id") @db.Uuid
  widgetKey           String   @map("widget_key")
  title               String
  valueJson           Json     @map("value_json")
  sourceQuery         String   @map("source_query")

  @@map("dashboard_widgets")
}

model NotificationDraft {
  id             String                  @id @default(uuid()) @db.Uuid
  organizationId String                  @map("organization_id") @db.Uuid
  assessmentId   String?                 @map("assessment_id") @db.Uuid
  jurisdiction   String
  notificationType String                @map("notification_type")
  status         NotificationDraftStatus @default(draft)
  payloadJson    Json                    @map("payload_json")
  sourceReferencesJson Json              @default("[]") @map("source_references_json")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")

  @@map("notification_drafts")
}

model RoNis2NotificationDraft {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  assessmentId         String?                 @map("assessment_id") @db.Uuid
  onboardingProgressId String?                 @map("onboarding_progress_id") @db.Uuid
  classificationRunId  String?                 @map("classification_run_id") @db.Uuid
  notificationDraftId  String?                 @map("notification_draft_id") @db.Uuid
  status               NotificationDraftStatus @default(draft)
  payloadJson          Json                    @map("payload_json")
  sourceReferencesJson Json                    @default("[]") @map("source_references_json")
  legalCaveat          String                  @map("legal_caveat")
  createdBy            String?                 @map("created_by") @db.Uuid
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")

  @@index([organizationId, status], map: "ro_nis2_notification_drafts_org_status_idx")
  @@map("ro_nis2_notification_drafts")
}

model BillingCustomer {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @unique @map("organization_id") @db.Uuid
  providerKey        BillingProviderKey @map("provider_key")
  externalCustomerId String?            @map("external_customer_id")
  billingEmail       String?            @map("billing_email")
  metadataJson       Json               @default("{}") @map("metadata_json")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  @@map("billing_customers")
}

model BillingSubscription {
  id                     String                    @id @default(uuid()) @db.Uuid
  organizationId         String                    @map("organization_id") @db.Uuid
  billingCustomerId      String                    @map("billing_customer_id") @db.Uuid
  providerKey            BillingProviderKey        @map("provider_key")
  externalSubscriptionId String?                   @map("external_subscription_id")
  externalPriceId        String?                   @map("external_price_id")
  externalProductId      String?                   @map("external_product_id")
  subscriptionStatus     BillingSubscriptionStatus @map("subscription_status")
  currentPeriodStart     DateTime?                 @map("current_period_start")
  currentPeriodEnd       DateTime?                 @map("current_period_end")
  cancelAtPeriodEnd      Boolean                   @default(false) @map("cancel_at_period_end")
  trialEnd               DateTime?                 @map("trial_end")
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")

  @@map("billing_subscriptions")
}

model BillingEntitlement {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  entitlementKey String   @map("entitlement_key")
  enabled        Boolean  @default(false)
  source         String
  expiresAt      DateTime? @map("expires_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([organizationId, entitlementKey], map: "billing_entitlements_org_key")
  @@map("billing_entitlements")
}

model BillingEvent {
  id              String             @id @default(uuid()) @db.Uuid
  organizationId  String?            @map("organization_id") @db.Uuid
  providerKey     BillingProviderKey @map("provider_key")
  externalEventId String             @map("external_event_id")
  eventType       String             @map("event_type")
  payloadJson     Json               @map("payload_json")
  processedAt     DateTime?          @map("processed_at")
  createdAt       DateTime           @default(now()) @map("created_at")

  @@unique([providerKey, externalEventId], map: "billing_events_provider_external_event_key")
  @@map("billing_events")
}
