generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProviderKey {
  local
  microsoft_entra
  google
  github
  keycloak_broker
}

enum OrganizationMemberStatus {
  invited
  active
  suspended
  removed
}

enum ProviderConnectionStatus {
  pending
  connected
  degraded
  revoked
  failed
}

enum ProviderCredentialType {
  oauth_token
  certificate
  service_account
  api_key
}

enum ProviderModuleStatus {
  pending
  running
  succeeded
  partial
  failed
  skipped
  unavailable_license
  missing_permission
  unsupported_api
  rate_limited
  revoked_consent
}

enum ResourceLifecycleStatus {
  active
  stale
  deleted
}

enum FindingSeverity {
  informational
  low
  medium
  high
  critical
}

enum ActionableSeverity {
  low
  medium
  high
  critical
}

enum FindingStatus {
  open
  acknowledged
  resolved
  suppressed
}

enum RecommendationType {
  manual
  guided
  technical
  process
  evidence_upload
  country_registration
  incident_reporting
}

enum AutomationMode {
  manual
  guided
  preflightable
  executable_later
}

enum RecommendationStatus {
  proposed
  accepted
  planned
  completed
  dismissed
}

enum ProviderActionRunStatus {
  draft
  preflight_pending
  preflight_failed
  preflight_passed
  approval_requested
  approval_rejected
  approved
  queued
  running
  failed
  verification_pending
  verification_failed
  verified
  closed
  canceled
}

enum ProviderActionPreflightStatus {
  not_run
  passed
  failed
}

enum ProviderActionApprovalStatus {
  not_requested
  requested
  approved
  rejected
}

enum ProviderActionVerificationStatus {
  not_run
  passed
  failed
  manual_required
}

enum RegulatorySourceType {
  directive
  regulation
  official_national_law
  official_authority_guidance
  official_registration_portal
  official_commission_country_page
  enisa_reference
  secondary_tracker
  internal_excel_seed
}

enum RegulatorySourceTrustLevel {
  primary
  secondary
  internal_seed
}

enum RegulatorySourceStatus {
  draft
  validated
  review_required
  active
  stale
  superseded
  unreachable
  needs_review
  deprecated
}

enum RegulatoryReviewTaskStatus {
  open
  reviewed
  rejected
  activated
}

enum RegulatoryReviewDecisionType {
  reviewed
  rejected
  activated
}

enum CountryPackCompleteness {
  baseline_only
  planned_full_pack
  official_sources_identified
  registration_rules_partial
  classification_rules_partial
  incident_rules_partial
  full_pack_ready
  requires_legal_review
  deprecated
}

enum AssessmentStatus {
  draft
  running
  completed
  superseded
}

enum ComplianceStatus {
  not_started
  not_applicable
  passing
  failing
  partial
  unsupported
  needs_evidence
  accepted_risk
}

enum EvidenceSourceType {
  provider_snapshot
  manual_upload
  generated_report
  signed_document
  checklist_completion
  action_pre_state
  action_post_state
  audit_log_export
  policy_document
  risk_acceptance
  regulatory_source_snapshot
  country_registration_draft
  incident_reporting_draft
}

enum EvidenceScanStatus {
  pending
  clean
  infected
  failed
  skipped
}

enum GeneratedReportStatus {
  draft
  rendering
  ready
  failed
  superseded
}

enum ExportStatus {
  queued
  running
  ready
  failed
  expired
}

enum NotificationDraftStatus {
  draft
  ready_for_review
  exported
  superseded
}

enum RoNis2ClassificationResult {
  insufficient_data
  out_of_scope
  voluntary_registration_possible
  important_entity
  essential_entity
}

enum RoNis2OnboardingStatus {
  draft
  in_progress
  ready_for_classification
  classification_complete
  ready_for_notification_export
}

enum BillingProviderKey {
  none
  stripe
  offline_license
}

enum BillingSubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
  incomplete_expired
  unpaid
  paused
  offline_active
  none
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique
  displayName     String?   @map("display_name")
  locale          String?   @default("en")
  disabledAt      DateTime? @map("disabled_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("users")
}

model IdentityAccount {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @map("user_id") @db.Uuid
  providerKey     AuthProviderKey @map("provider_key")
  providerSubject String          @map("provider_subject")
  providerEmail   String?         @map("provider_email")
  displayName     String?         @map("display_name")
  createdAt       DateTime        @default(now()) @map("created_at")
  lastLoginAt     DateTime?       @map("last_login_at")

  @@unique([providerKey, providerSubject], map: "identity_accounts_provider_subject_key")
  @@map("identity_accounts")
}

model LocalCredential {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @unique @map("user_id") @db.Uuid
  email                 String    @unique
  passwordHash          String    @map("password_hash")
  passwordHashAlgorithm String    @map("password_hash_algorithm")
  passwordUpdatedAt     DateTime  @map("password_updated_at")
  emailVerifiedAt       DateTime? @map("email_verified_at")
  failedLoginCount      Int       @default(0) @map("failed_login_count")
  lockedUntil           DateTime? @map("locked_until")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("local_credentials")
}

model Session {
  id                   String    @id @default(uuid()) @db.Uuid
  userId               String    @map("user_id") @db.Uuid
  activeOrganizationId String?   @map("active_organization_id") @db.Uuid
  sessionHash          String    @map("session_hash")
  ipAddress            String?   @map("ip_address")
  userAgent            String?   @map("user_agent")
  expiresAt            DateTime  @map("expires_at")
  revokedAt            DateTime? @map("revoked_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  @@unique([sessionHash], map: "sessions_session_hash_key")
  @@index([userId, revokedAt, expiresAt], map: "sessions_user_active_idx")
  @@map("sessions")
}

model MfaFactor {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  factorType   String    @map("factor_type")
  displayName  String?   @map("display_name")
  secretHash   String?   @map("secret_hash")
  enabledAt    DateTime? @map("enabled_at")
  disabledAt   DateTime? @map("disabled_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("mfa_factors")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([tokenHash], map: "password_reset_tokens_token_hash_key")
  @@index([userId, expiresAt], map: "password_reset_tokens_user_expiry_idx")
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  email     String
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([tokenHash], map: "email_verification_tokens_token_hash_key")
  @@index([userId, email, expiresAt], map: "email_verification_tokens_user_email_expiry_idx")
  @@map("email_verification_tokens")
}

model OidcAuthorizationState {
  id                   String          @id @default(uuid()) @db.Uuid
  providerKey          AuthProviderKey @map("provider_key")
  stateHash            String          @map("state_hash")
  nonceHash            String?         @map("nonce_hash")
  codeVerifierEnvelope String          @map("code_verifier_envelope")
  redirectUri          String          @map("redirect_uri")
  createdAt            DateTime        @default(now()) @map("created_at")
  expiresAt            DateTime        @map("expires_at")
  consumedAt           DateTime?       @map("consumed_at")

  @@unique([providerKey, stateHash], map: "oidc_authorization_states_provider_state_key")
  @@index([expiresAt, consumedAt], map: "oidc_authorization_states_expiry_idx")
  @@map("oidc_authorization_states")
}

model Organization {
  id                      String    @id @default(uuid()) @db.Uuid
  name                    String
  legalName               String?   @map("legal_name")
  billingStatus           String    @default("none") @map("billing_status")
  defaultLocale           String    @default("en") @map("default_locale")
  primaryCountryCode      String?   @map("primary_country_code")
  headquartersCountryCode String?   @map("headquarters_country_code")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("organizations")
}

model OrganizationMember {
  id             String                   @id @default(uuid()) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  status         OrganizationMemberStatus @default(invited)
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@unique([organizationId, userId], map: "organization_members_org_user_key")
  @@map("organization_members")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("roles")
}

model RoleBinding {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  scopeJson      Json     @default("{}") @map("scope_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, userId, roleId], map: "role_bindings_org_user_role_key")
  @@index([organizationId, userId], map: "role_bindings_org_user_idx")
  @@map("role_bindings")
}

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  targetType     String   @map("target_type")
  targetId       String?  @map("target_id")
  action         String
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  previousHash   String?  @map("previous_hash")
  entryHash      String?  @map("entry_hash")
  hashAlgorithm  String?  @map("hash_algorithm")
  canonicalPayload Json?  @map("canonical_payload")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt], map: "audit_logs_org_created_idx")
  @@index([actorUserId, createdAt], map: "audit_logs_actor_created_idx")
  @@index([action, createdAt], map: "audit_logs_action_created_idx")
  @@index([organizationId, entryHash], map: "audit_logs_org_entry_hash_idx")
  @@map("audit_logs")
}

model AuditCheckpoint {
  id                          String   @id @default(uuid()) @db.Uuid
  organizationId              String?  @map("organization_id") @db.Uuid
  scopeType                   String   @map("scope_type")
  exportId                    String   @map("export_id")
  exportedAt                  DateTime @map("exported_at")
  createdAt                   DateTime @default(now()) @map("created_at")
  createdByUserId             String?  @map("created_by_user_id") @db.Uuid
  recordCount                 Int      @map("record_count")
  firstRecordId               String?  @map("first_record_id")
  terminalRecordId            String?  @map("terminal_record_id")
  initialPreviousHash         String?  @map("initial_previous_hash")
  terminalHash                String?  @map("terminal_hash")
  exportHash                  String   @map("export_hash")
  hashAlgorithm               String   @map("hash_algorithm")
  verificationStatus          String   @map("verification_status")
  verificationViolationsJson  Json     @default("[]") @map("verification_violations_json")
  externalCheckpointStatus    String   @default("not_configured") @map("external_checkpoint_status")
  externalCheckpointReference String?  @map("external_checkpoint_reference")
  guaranteesJson              Json     @default("{}") @map("guarantees_json")

  @@index([organizationId, createdAt], map: "audit_checkpoints_org_created_idx")
  @@index([organizationId, terminalHash], map: "audit_checkpoints_org_terminal_hash_idx")
  @@map("audit_checkpoints")
}

model CustomerProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  displayName    String   @map("display_name")
  legalName      String?  @map("legal_name")
  taxIdentifier  String?  @map("tax_identifier")
  metadataJson   Json     @default("{}") @map("metadata_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("customer_profiles")
}

model BusinessProfile {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerProfileId String? @map("customer_profile_id") @db.Uuid
  entityName     String   @map("entity_name")
  sectorJson     Json     @default("{}") @map("sector_json")
  sizeJson       Json     @default("{}") @map("size_json")
  answersJson    Json     @default("{}") @map("answers_json")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("business_profiles")
}

model BusinessLocation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessProfileId String @map("business_profile_id") @db.Uuid
  countryCode    String   @map("country_code")
  region         String?
  city           String?
  addressLine    String?  @map("address_line")
  isHeadquarters Boolean  @default(false) @map("is_headquarters")

  @@map("business_locations")
}

model BusinessContact {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessProfileId String @map("business_profile_id") @db.Uuid
  role           String
  name           String
  email          String?
  phone          String?

  @@map("business_contacts")
}

model BusinessService {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessProfileId String @map("business_profile_id") @db.Uuid
  serviceKey     String   @map("service_key")
  name           String
  description    String?
  criticality    String?

  @@map("business_services")
}

model BusinessServiceCountry {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  businessServiceId String @map("business_service_id") @db.Uuid
  countryCode       String @map("country_code")

  @@unique([businessServiceId, countryCode], map: "business_service_countries_service_country_key")
  @@map("business_service_countries")
}

model BusinessNaceCode {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  businessProfileId String @map("business_profile_id") @db.Uuid
  code           String
  label          String?

  @@map("business_nace_codes")
}

model BusinessSizeAssessment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessProfileId String @map("business_profile_id") @db.Uuid
  employeeCount  Int?     @map("employee_count")
  annualRevenue  Decimal? @map("annual_revenue")
  balanceSheetTotal Decimal? @map("balance_sheet_total")
  sizeCategory   String?  @map("size_category")
  sourceJson     Json     @default("{}") @map("source_json")
  assessedAt     DateTime @default(now()) @map("assessed_at")

  @@map("business_size_assessments")
}

model JurisdictionAssessment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessProfileId String? @map("business_profile_id") @db.Uuid
  jurisdiction   String
  applicability  String
  classification String?
  rationaleJson  Json     @default("{}") @map("rationale_json")
  assessedAt     DateTime @default(now()) @map("assessed_at")

  @@map("jurisdiction_assessments")
}

model RoNis2OnboardingProgress {
  id                    String                 @id @default(uuid()) @db.Uuid
  organizationId        String                 @map("organization_id") @db.Uuid
  assessmentId          String?                @map("assessment_id") @db.Uuid
  businessProfileId     String?                @map("business_profile_id") @db.Uuid
  status                RoNis2OnboardingStatus @default(draft)
  currentStep           String                 @map("current_step")
  completedSteps        String[]               @map("completed_steps")
  answersJson           Json                   @default("{}") @map("answers_json")
  sourceVersion         String                 @map("source_version")
  sourceReferencesJson  Json                   @default("[]") @map("source_references_json")
  missingRequiredFields String[]               @map("missing_required_fields")
  savedBy               String?                @map("saved_by") @db.Uuid
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  @@index([organizationId, status], map: "ro_nis2_onboarding_progress_org_status_idx")
  @@map("ro_nis2_onboarding_progress")
}

model CustomerDocument {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  customerProfileId String? @map("customer_profile_id") @db.Uuid
  title          String
  documentType   String   @map("document_type")
  storageUri     String   @map("storage_uri")
  contentHashSha256 String @map("content_hash_sha256")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("customer_documents")
}

model ProviderConnection {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  providerKey           String                   @map("provider_key")
  displayName           String                   @map("display_name")
  externalTenantId      String?                  @map("external_tenant_id")
  externalTenantName    String?                  @map("external_tenant_name")
  status                ProviderConnectionStatus @default(pending)
  readEnabled           Boolean                  @default(true) @map("read_enabled")
  writeEnabled          Boolean                  @default(false) @map("write_enabled")
  metadataJson          Json                     @default("{}") @map("metadata_json")
  lastSuccessfulSyncAt  DateTime?                @map("last_successful_sync_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")

  @@map("provider_connections")
}

model ProviderCredential {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  providerConnectionId String                 @map("provider_connection_id") @db.Uuid
  providerKey          String                 @map("provider_key")
  credentialType       ProviderCredentialType @map("credential_type")
  encryptedPayload     String                 @map("encrypted_payload")
  expiresAt            DateTime?              @map("expires_at")
  rotationRequired     Boolean                @default(false) @map("rotation_required")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  @@unique([providerConnectionId, credentialType], map: "provider_credentials_connection_type_key")
  @@map("provider_credentials")
}

model ProviderPermissionBundle {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  providerConnectionId String   @map("provider_connection_id") @db.Uuid
  providerKey          String   @map("provider_key")
  bundleKey            String   @map("bundle_key")
  permissionsRequired  String[] @map("permissions_required")
  permissionsGranted   String[] @map("permissions_granted")
  enabled              Boolean  @default(false)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  @@unique([providerConnectionId, bundleKey], map: "provider_permission_bundles_connection_bundle_key")
  @@map("provider_permission_bundles")
}

model ProviderCapability {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  providerConnectionId String               @map("provider_connection_id") @db.Uuid
  providerKey          String               @map("provider_key")
  moduleKey            String               @map("module_key")
  capabilityKey        String               @map("capability_key")
  available            Boolean              @default(false)
  licenseRequired      String[]             @map("license_required")
  licenseDetected      String[]             @map("license_detected")
  permissionsRequired  String[]             @map("permissions_required")
  permissionsGranted   String[]             @map("permissions_granted")
  status               ProviderModuleStatus @default(pending)
  statusReason         String?              @map("status_reason")
  updatedAt            DateTime             @updatedAt @map("updated_at")

  @@unique([providerConnectionId, capabilityKey], map: "provider_capabilities_connection_capability_key")
  @@map("provider_capabilities")
}

model ProviderSyncRun {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  providerConnectionId String               @map("provider_connection_id") @db.Uuid
  providerKey          String               @map("provider_key")
  status               ProviderModuleStatus @default(pending)
  startedAt            DateTime             @default(now()) @map("started_at")
  completedAt          DateTime?            @map("completed_at")
  errorJson            Json?                @map("error_json")
  summaryJson          Json                 @default("{}") @map("summary_json")

  @@map("provider_sync_runs")
}

model ProviderSyncModule {
  id                   String               @id @default(uuid()) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  providerConnectionId String               @map("provider_connection_id") @db.Uuid
  syncRunId            String               @map("sync_run_id") @db.Uuid
  providerKey          String               @map("provider_key")
  moduleKey            String               @map("module_key")
  status               ProviderModuleStatus @default(pending)
  missingPermissions   String[]             @map("missing_permissions")
  missingLicenses      String[]             @map("missing_licenses")
  statusReason         String?              @map("status_reason")
  pagesRead            Int                  @default(0) @map("pages_read")
  retryCount           Int                  @default(0) @map("retry_count")
  startedAt            DateTime             @default(now()) @map("started_at")
  completedAt          DateTime?            @map("completed_at")

  @@unique([syncRunId, moduleKey], map: "provider_sync_modules_run_module_key")
  @@map("provider_sync_modules")
}

model ProviderRawResource {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  providerConnectionId String                  @map("provider_connection_id") @db.Uuid
  providerKey          String                  @map("provider_key")
  externalId           String                  @map("external_id")
  externalResourceType String                  @map("external_resource_type")
  sourceModule         String                  @map("source_module")
  syncRunId            String                  @map("sync_run_id") @db.Uuid
  rawJson              Json                    @map("raw_json")
  contentHash          String                  @map("content_hash")
  firstSeenAt          DateTime                @default(now()) @map("first_seen_at")
  lastSeenAt           DateTime                @default(now()) @map("last_seen_at")
  deletedAt            DateTime?               @map("deleted_at")
  lifecycleStatus      ResourceLifecycleStatus @default(active) @map("lifecycle_status")

  @@unique([organizationId, providerConnectionId, providerKey, externalResourceType, externalId], map: "provider_resource_idempotency_key")
  @@map("provider_raw_resources")
}

model ProviderNormalizedResource {
  id                   String                  @id @default(uuid()) @db.Uuid
  organizationId       String                  @map("organization_id") @db.Uuid
  providerConnectionId String                  @map("provider_connection_id") @db.Uuid
  providerKey          String                  @map("provider_key")
  rawResourceId        String?                 @map("raw_resource_id") @db.Uuid
  externalId           String                  @map("external_id")
