{
  "name": "@puresoc/workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "drift": "jiti scripts/check-schema-contract-drift.ts && jiti scripts/check-generated-regulatory-drift.ts",
    "drift:regulatory": "jiti scripts/check-generated-regulatory-drift.ts",
    "drift:schema": "jiti scripts/check-schema-contract-drift.ts",
    "lint": "node scripts/check-layout.mjs && jiti scripts/check-schema-contract-drift.ts && jiti scripts/check-generated-regulatory-drift.ts && tsc -p tsconfig.base.json --noEmit",
    "typecheck": "tsc -p tsconfig.base.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-ui-smoke.mjs",
    "test:watch": "vitest",
    "start:api": "jiti apps/api/src/main.ts",
    "start:web": "jiti apps/web/src/server.ts",
    "start:worker": "jiti apps/worker/src/main.ts",
    "start:scheduler": "jiti apps/scheduler/src/main.ts",
    "start:connector-runner": "jiti apps/connector-runner/src/main.ts",
    "start:regulatory-importer": "jiti apps/regulatory-importer/src/cli.ts",
    "start:report-renderer": "jiti apps/report-renderer/src/server.ts",
    "external-smoke:readiness": "jiti scripts/external-smoke-readiness.ts",
    "external-smoke:select-target": "jiti scripts/external-smoke-target-selection.ts",
    "auth:smoke:deployment": "jiti scripts/auth-deployment-smoke.ts",
    "oidc:smoke:callback": "jiti scripts/oidc-callback-smoke.ts",
    "microsoft365:smoke:read-only": "jiti scripts/microsoft365-read-only-smoke.ts",
    "evidence:smoke:runtime": "jiti scripts/evidence-runtime-smoke.ts",
    "stripe:smoke:test-mode": "jiti scripts/stripe-test-mode-smoke.ts",
    "provider-token:smoke": "jiti scripts/provider-token-rotation-smoke.ts",
    "jobs:smoke:redis": "jiti scripts/live-redis-bullmq-smoke.ts",
    "prisma:validate": "prisma validate --schema packages/database/prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:status": "prisma migrate status --schema packages/database/prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "prisma:smoke:postgres": "jiti scripts/live-postgres-prisma-smoke.ts",
    "compose:config": "docker compose -f infra/compose/docker-compose.yml config",
    "compose:config:build": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.build.yml config",
    "compose:build": "COMPOSE_BAKE=false docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.build.yml build",
    "compose:up": "docker compose -f infra/compose/docker-compose.yml -f infra/compose/docker-compose.build.yml up --build -d"
  },
  "devDependencies": {
    "@puresoc/api": "workspace:*",
    "@puresoc/compliance-core": "workspace:*",
    "@puresoc/config": "workspace:*",
    "@puresoc/dashboards": "workspace:*",
    "@puresoc/database": "workspace:*",
    "@puresoc/evidence": "workspace:*",
    "@puresoc/jobs": "workspace:*",
    "@puresoc/provider-microsoft365": "workspace:*",
    "@puresoc/provider-mock": "workspace:*",
    "@puresoc/providers-core": "workspace:*",
    "@puresoc/recommendations": "workspace:*",
    "@puresoc/regulatory-sources": "workspace:*",
    "@puresoc/reports": "workspace:*",
    "@puresoc/shared": "workspace:*",
    "@types/node": "^22.10.10",
    "jiti": "^2.6.1",
    "prisma": "6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
