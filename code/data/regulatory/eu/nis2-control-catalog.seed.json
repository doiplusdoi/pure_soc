        }
      ],
      "manualChecklistTemplateIds": ["mfa-rollout-review"]
    },
    {
      "id": "nis2.incident-handling",
      "code": "NIS2-EU-INC-001",
      "title": "Incident handling",
      "description": "Maintain incident handling procedures and evidence for open incident triage.",
      "controlGroup": "NIS2-EU-INC",
      "implementationType": "hybrid",
      "applicability": "all",
      "legalReference": [
        {
